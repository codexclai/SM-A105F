# Linux 6.18.54 A10 root-storage/initramfs support fragment.
# Merge with the project A10 kernel defconfig; this is not a standalone config.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
