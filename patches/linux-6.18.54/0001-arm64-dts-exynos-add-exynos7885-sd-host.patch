From: SM-A105F Linux 6.18.54 board port
Subject: [PATCH] arm64: dts: exynos: describe Exynos7885 removable SD host

Add the second DesignWare MMC host used for removable SD on A10-family
Exynos7884B systems. Register, IRQ, clock routing, CIU divider, and legacy
timing parameters are sourced from the public geckyn Exynos7885/A10
downstream tree. Keep the shared SoC node disabled; board DTS must supply
the pins, card detect and power controls.

This is a host-tested porting fragment, not a bootable A10 board DTS.
---
 arch/arm64/boot/dts/exynos/exynos7885.dtsi | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7885.dtsi b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
index 000000000000..000000000000 100644
--- a/arch/arm64/boot/dts/exynos/exynos7885.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
@@ -310,6 +310,22 @@
 			status = "disabled";
 		};
 
+		/* Optional removable SD host; board DTS supplies pins and slot details. */
+		mmc_2: mmc@13550000 {
+			compatible = "samsung,exynos7-dw-mshc";
+			reg = <0x13550000 0x2000>;
+			interrupts = <GIC_SPI 147 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			clocks = <&cmu_fsys CLK_GOUT_MMC_CARD_ACLK>,
+				 <&cmu_fsys CLK_GOUT_MMC_CARD_SDCLKIN>;
+			clock-names = "biu", "ciu";
+			fifo-depth = <0x40>;
+			samsung,dw-mshc-ciu-div = <3>;
+			samsung,dw-mshc-sdr-timing = <3 0 2 0>;
+			samsung,dw-mshc-ddr-timing = <3 0 2 1>;
+			status = "disabled";
+		};
+
 		serial_0: serial@13800000 {
