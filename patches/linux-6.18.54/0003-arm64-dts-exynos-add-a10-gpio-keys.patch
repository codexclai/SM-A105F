From: SM-A105F Linux 6.18.54 board port
Subject: [PATCH] arm64: dts: exynos: add A10 GPIO keys

Add the three A10 side keys from the exact Samsung overlay. Use generic
gpio-keys GPIO descriptors with active-low flags, Exynos EINT pinctrl, and
no-pull configuration. The power key is wake-capable. Omit legacy direct
interrupt tuples because the generic driver derives IRQs from GPIOs.

---
 arch/arm64/boot/dts/exynos/exynos7885-a10.dts | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7885-a10.dts b/arch/arm64/boot/dts/exynos/exynos7885-a10.dts
--- a/arch/arm64/boot/dts/exynos/exynos7885-a10.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7885-a10.dts
@@ -2,6 +2,7 @@
 /dts-v1/;
 
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
 #include "exynos7885.dtsi"
 
 / {
@@ -23,6 +24,11 @@
 	a10_sd_cd: a10-sd-card-detect-pins {
 		samsung,pins = "gpa0-7";
 		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+	};
+	a10_keys_pins: a10-keys-pins {
+		samsung,pins = "gpa1-5", "gpa1-6", "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 	};
 };
 
@@ -57,6 +63,30 @@
 	chosen {
 		stdout-path = &serial_2;
 	};
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&a10_keys_pins>;
+
+		button-volume-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
+		};
+
+		button-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+		};
+
+		button-power {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
 };
 
 /* Samsung A10 enables non-removable 8-bit eMMC; base CLKSEL fields only. */
