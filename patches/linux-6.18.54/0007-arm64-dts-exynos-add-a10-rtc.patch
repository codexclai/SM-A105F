From: A10 Port Engineering <noreply@example.invalid>
Subject: [PATCH 7/7] rtc: s3c: add Exynos8 RTC support

Use the exact Samsung A10 Exynos8 RTC compatible and retain its clockless
contract. Share the disabled block at SoC level and enable it only on A10.

diff --git a/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml b/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml
index 338874e7e..7579125bd 100644
--- a/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml
+++ b/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml
@@ -19,6 +19,7 @@ properties:
               - samsung,exynos7-rtc
               - samsung,exynos850-rtc
           - const: samsung,s3c6410-rtc
+      - const: samsung,exynos8-rtc
       - const: samsung,exynos3250-rtc
         deprecated: true

@@ -35,15 +36,32 @@ properties:
 
   interrupts:
     description:
-      Two interrupt numbers to the cpu should be specified. First
-      interrupt number is the rtc alarm interrupt and second interrupt number
-      is the rtc tick interrupt. The number of cells representing a interrupt
+      The first interrupt is the RTC alarm interrupt. Legacy S3C variants
+      also use the second interrupt for the RTC tick output. Exynos8 hardware
+      exposes alarm, tick_0, and tick_1 interrupts in that order; the Linux
+      driver currently uses only the alarm interrupt. The number of cells
       depends on the parent interrupt controller.
     minItems: 2
-    maxItems: 2
+    maxItems: 3
 
 allOf:
   - $ref: rtc.yaml#
+  - if:
+      properties:
+        compatible:
+          const: samsung,exynos8-rtc
+      required:
+        - compatible
+    then:
+      properties:
+        interrupts:
+          minItems: 3
+          maxItems: 3
+    else:
+      properties:
+        interrupts:
+          minItems: 2
+          maxItems: 2
 
 unevaluatedProperties: false
 
diff --git a/arch/arm64/boot/dts/exynos/exynos7885-a10.dts b/arch/arm64/boot/dts/exynos/exynos7885-a10.dts
index 622aab17d..da0d37380 100644
--- a/arch/arm64/boot/dts/exynos/exynos7885-a10.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7885-a10.dts
@@ -106,6 +106,10 @@ button-power {
 };
 
 /* Samsung A10 enables non-removable 8-bit eMMC; base CLKSEL fields only. */
+&rtc {
+	status = "okay";
+};
+
 &mmc_0 {
 	status = "okay";
 	non-removable;
diff --git a/arch/arm64/boot/dts/exynos/exynos7885.dtsi b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
index 944785b96..d4bb5148e 100644
--- a/arch/arm64/boot/dts/exynos/exynos7885.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
@@ -324,6 +324,15 @@ mmc_2: mmc@13550000 {
 			status = "disabled";
 		};
 
+		rtc: rtc@11c90000 {
+			compatible = "samsung,exynos8-rtc";
+			reg = <0x11c90000 0x100>;
+			interrupts = <GIC_SPI 27 IRQ_TYPE_NONE>,
+				     <GIC_SPI 28 IRQ_TYPE_NONE>,
+				     <GIC_SPI 36 IRQ_TYPE_NONE>;
+			status = "disabled";
+		};
+
 		watchdog: watchdog@10060000 {
 			compatible = "samsung,exynos8-wdt";
 			reg = <0x10060000 0x100>;
diff --git a/drivers/rtc/rtc-s3c.c b/drivers/rtc/rtc-s3c.c
index 291c0ccb0..5626e781e 100644
--- a/drivers/rtc/rtc-s3c.c
+++ b/drivers/rtc/rtc-s3c.c
@@ -48,6 +48,7 @@ struct s3c_rtc {
 
 struct s3c_rtc_data {
 	bool needs_src_clk;
+	bool no_clk;
 
 	void (*irq_handler) (struct s3c_rtc *info, int mask);
 	void (*enable) (struct s3c_rtc *info);
@@ -58,6 +59,9 @@ static int s3c_rtc_enable_clk(struct s3c_rtc *info)
 {
 	int ret;
 
+	if (info->data->no_clk)
+		return 0;
+
 	ret = clk_enable(info->rtc_clk);
 	if (ret)
 		return ret;
@@ -74,6 +78,9 @@ static int s3c_rtc_enable_clk(struct s3c_rtc *info)
 
 static void s3c_rtc_disable_clk(struct s3c_rtc *info)
 {
+	if (info->data->no_clk)
+		return;
+
 	if (info->data->needs_src_clk)
 		clk_disable(info->rtc_src_clk);
 	clk_disable(info->rtc_clk);
@@ -377,9 +384,11 @@ static void s3c_rtc_remove(struct platform_device *pdev)
 
 	s3c_rtc_setaie(info->dev, 0);
 
-	if (info->data->needs_src_clk)
-		clk_unprepare(info->rtc_src_clk);
-	clk_unprepare(info->rtc_clk);
+	if (!info->data->no_clk) {
+		if (info->data->needs_src_clk)
+			clk_unprepare(info->rtc_src_clk);
+		clk_unprepare(info->rtc_clk);
+	}
 }
 
 static int s3c_rtc_probe(struct platform_device *pdev)
@@ -412,26 +421,28 @@ static int s3c_rtc_probe(struct platform_device *pdev)
 	if (IS_ERR(info->base))
 		return PTR_ERR(info->base);
 
-	info->rtc_clk = devm_clk_get(&pdev->dev, "rtc");
-	if (IS_ERR(info->rtc_clk))
-		return dev_err_probe(&pdev->dev, PTR_ERR(info->rtc_clk),
-				     "failed to find rtc clock\n");
-	ret = clk_prepare_enable(info->rtc_clk);
-	if (ret)
-		return ret;
-
-	if (info->data->needs_src_clk) {
-		info->rtc_src_clk = devm_clk_get(&pdev->dev, "rtc_src");
-		if (IS_ERR(info->rtc_src_clk)) {
-			ret = dev_err_probe(&pdev->dev, PTR_ERR(info->rtc_src_clk),
-					    "failed to find rtc source clock\n");
-			goto err_src_clk;
-		}
-		ret = clk_prepare_enable(info->rtc_src_clk);
-		if (ret)
-			goto err_src_clk;
+	if (!info->data->no_clk) {
+		info->rtc_clk = devm_clk_get(&pdev->dev, "rtc");
+		if (IS_ERR(info->rtc_clk))
+			return dev_err_probe(&pdev->dev, PTR_ERR(info->rtc_clk),
+					     "failed to find rtc clock\n");
+		ret = clk_prepare_enable(info->rtc_clk);
+		if (ret)
+			return ret;
+
+		if (info->data->needs_src_clk) {
+			info->rtc_src_clk = devm_clk_get(&pdev->dev, "rtc_src");
+			if (IS_ERR(info->rtc_src_clk)) {
+				ret = dev_err_probe(&pdev->dev, PTR_ERR(info->rtc_src_clk),
+						    "failed to find rtc source clock\n");
+				goto err_src_clk;
+			}
+			ret = clk_prepare_enable(info->rtc_src_clk);
+			if (ret)
+				goto err_src_clk;
+		}
 	}
+
 	/* disable RTC enable bits potentially set by the bootloader */
 	if (info->data->disable)
 		info->data->disable(info);
@@ -474,10 +485,11 @@ static int s3c_rtc_probe(struct platform_device *pdev)
 	if (info->data->disable)
 		info->data->disable(info);
 
-	if (info->data->needs_src_clk)
+	if (!info->data->no_clk && info->data->needs_src_clk)
 		clk_disable_unprepare(info->rtc_src_clk);
 err_src_clk:
-	clk_disable_unprepare(info->rtc_clk);
+	if (!info->data->no_clk)
+		clk_disable_unprepare(info->rtc_clk);
 
 	return ret;
 }
@@ -538,8 +550,18 @@ static const struct s3c_rtc_data s3c6410_rtc_data = {
 	.disable		= s3c6410_rtc_disable,
 };
 
+static const struct s3c_rtc_data exynos8_rtc_data = {
+	.no_clk			= true,
+	.irq_handler		= s3c6410_rtc_irq,
+	.enable			= s3c6410_rtc_enable,
+	.disable		= s3c6410_rtc_disable,
+};
+
 static const __maybe_unused struct of_device_id s3c_rtc_dt_match[] = {
 	{
+		.compatible = "samsung,exynos8-rtc",
+		.data = &exynos8_rtc_data,
+	}, {
 		.compatible = "samsung,s3c6410-rtc",
 		.data = &s3c6410_rtc_data,
 	}, {
